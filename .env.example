# Il codice per pubblicare bollettini (/api/bulletins) non e' piu' una variabile
# d'ambiente: vive in src/lib/bulletinPublishCode.js (oggi "FirenzePc2026") ed e' lo
# stesso valore che la dashboard propone nel prompt e ricorda nel browser.
# BULLETIN_WRITE_CODE e BULLETIN_WRITE_TOKEN non vengono piu' letti dal server.

# Optional: override the CFR Toscana page parsed by /api/cfr-data.
CFR_MONITORING_URL=https://www.cfr.toscana.it/monitoraggio/

# Optional: set exact Geoscopio WMS endpoints/layers after checking the official GetCapabilities document.
NEXT_PUBLIC_WMS_ALLUVIONI_URL=https://www502.regione.toscana.it/geoscopio_qg/cgi-bin/qgis_mapserv.fcgi
NEXT_PUBLIC_WMS_ALLUVIONI_LAYER=pericolosita_idraulica
NEXT_PUBLIC_WMS_SISMICA_URL=https://www502.regione.toscana.it/geoscopio_qg/cgi-bin/qgis_mapserv.fcgi
NEXT_PUBLIC_WMS_SISMICA_LAYER=classificazione_sismica

# Optional GeoJSON layers for Leaflet overlays.
GEOSCOPIO_PI_GEOJSON_URL=
GEOSCOPIO_FRANE_GEOJSON_URL=

# Optional Tomorrow.io key if you want to extend /api/weather-data beyond Open-Meteo.
TOMORROW_API_KEY=

# Optional MeteoHub credentials. Keep real values only in .env.local.
METEOHUB_USERNAME=
METEOHUB_PASSWORD=
METEOHUB_API_BASE=https://meteohub.agenziaitaliameteo.it

# Optional cache/cron settings for /api/observations.
OBSERVATION_CACHE_TTL_SECONDS=900
CRON_SECRET=

# Cache di processo per /api/hydrometry: documenti OpenData (SIR) e risultati normalizzati.
# Il documento SIR pesa ~1,4 MB e impiega 7-9 s, quindi il timeout dedicato e' piu' alto
# di quello generico; gli errori restano memorizzati solo pochi secondi.
HYDROMETRY_CACHE_TTL_SECONDS=900
HYDROMETRY_REALTIME_CACHE_TTL_SECONDS=120
HYDROMETRY_SOURCE_FETCH_TIMEOUT_MS=25000
HYDROMETRY_FAILURE_CACHE_TTL_SECONDS=30

# Cache persistente Vercel KV / Upstash REST per i batch CFR programmati
KV_REST_API_URL=
KV_REST_API_TOKEN=
OBSERVATION_CACHE_KEY=firenze:observation-cache:v1
OBSERVATION_PERSISTED_CACHE_TTL_SECONDS=21600
